msgid "rule.docker_vm.why"
msgstr "Docker Desktop's virtual disk. Clean it only through Docker commands, never by deleting files."

msgid "rule.icloud_drive.why"
msgstr "iCloud Drive: your synced documents."

msgid "rule.keychains.why"
msgstr "Keychains with your passwords and certificates."

msgid "rule.mail.why"
msgstr "Mail data: your messages and attachments."

msgid "rule.messages.why"
msgstr "Messages history and attachments."

msgid "rule.system.why"
msgstr "macOS system files. Deleting them can break the system."

msgid "rule.vm_swap.why"
msgstr "Swap and sleep image, managed by macOS."

msgid "rule.var_db.why"
msgstr "System databases (permissions, configuration)."

msgid "rule.var_folders.why"
msgstr "Per-user temporary data managed by macOS."

msgid "rule.usr.why"
msgstr "Core Unix system files."

msgid "rule.simulator_runtimes.why"
msgstr "Simulator runtimes. Removed only via the simctl command item."

msgid "rule.derived_data.why"
msgstr "Xcode build products; rebuilt on the next build."

msgid "rule.xcode_archives.why"
msgstr "App archives; needed to symbolicate crashes or resubmit a build."

msgid "rule.ios_device_support.why"
msgstr "Debug symbols for a connected iOS version; re-downloaded when a device connects."

msgid "rule.watchos_device_support.why"
msgstr "Debug symbols for watchOS; re-downloaded when a watch connects."

msgid "rule.simulator_caches.why"
msgstr "Simulator caches; regenerated automatically."

msgid "rule.simulator_devices.why"
msgstr "A simulator device with its installed apps and their data."

msgid "rule.xcode_cache.why"
msgstr "Xcode cache; regenerated automatically."

msgid "rule.xcode_previews.why"
msgstr "SwiftUI preview builds; rebuilt when needed."

msgid "rule.gradle_caches.why"
msgstr "Gradle dependency cache; downloaded again on the next build."

msgid "rule.gradle_wrapper.why"
msgstr "Downloaded Gradle distributions; re-downloaded when needed."

msgid "rule.android_avd.why"
msgstr "Android emulator with its data and installed apps."

msgid "rule.android_system_images.why"
msgstr "Android system image; large download to get it back."

msgid "rule.docker_build_cache.why"
msgstr "Docker build cache; rebuilt on the next build."

msgid "rule.docker_dangling_images.why"
msgstr "Untagged leftover image layers."

msgid "rule.docker_unused_images.why"
msgstr "Images no container uses; you'll need to pull them again."

msgid "rule.docker_stopped_containers.why"
msgstr "Stopped containers; their writable data is lost."

msgid "rule.docker_volumes.why"
msgstr "Volumes may hold local database data."

msgid "rule.pnpm_global.why"
msgstr "Global pnpm packages; their commands stop working without them."

msgid "rule.npm_cache.why"
msgstr "npm download cache; refilled by npm install."

msgid "rule.yarn_cache.why"
msgstr "Yarn download cache; refilled by yarn install."

msgid "rule.yarn_berry_cache.why"
msgstr "Yarn Berry global cache; refilled by yarn install."

msgid "rule.pnpm_store.why"
msgstr "pnpm package store; refilled by pnpm install."

msgid "rule.homebrew_cache.why"
msgstr "Homebrew downloads; not needed after install."

msgid "rule.cocoapods_cache.why"
msgstr "CocoaPods download cache; refilled by pod install."

msgid "rule.cocoapods_repos.why"
msgstr "CocoaPods spec repos; cloned again when needed."

msgid "rule.user_logs.why"
msgstr "Application logs; recreated as apps run."

msgid "rule.diagnostic_reports.why"
msgstr "System crash and diagnostic reports."

msgid "rule.tm_snapshots.why"
msgstr "Local Time Machine snapshot kept on this disk."

msgid "rule.simctl_runtimes.why"
msgstr "Simulator runtime; you can't run simulators of this OS version after removal."

msgid "rule.simctl_unavailable_devices.why"
msgstr "Simulators whose runtime is gone; they can't run anymore."

msgid "rule.system_caches.why"
msgstr "System-wide app cache; usually regenerated, some apps may lose offline data."

msgid "rule.user_caches.why"
msgstr "App cache; usually regenerated, some apps may lose offline data."

msgid "rule.node_modules.why"
msgstr "Project dependencies; restored by yarn/npm install."

msgid "rule.node_modules_recent.why"
msgstr "Used recently; deleting forces a fresh yarn/npm install."

msgid "hint.tm_keep_newest"
msgstr "Keep the newest snapshot, remove older ones."

msgid "hint.runtime_keep_current"
msgstr "Keep the runtime your Xcode uses, remove older ones."
