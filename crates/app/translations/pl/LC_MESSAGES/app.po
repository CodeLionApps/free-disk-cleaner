msgid "rule.docker_vm.why"
msgstr "Dysk wirtualny Docker Desktop. Czyść go tylko poleceniami Dockera, nigdy przez kasowanie plików."

msgid "rule.icloud_drive.why"
msgstr "iCloud Drive: Twoje synchronizowane dokumenty."

msgid "rule.keychains.why"
msgstr "Pęki kluczy z hasłami i certyfikatami."

msgid "rule.mail.why"
msgstr "Dane Poczty: wiadomości i załączniki."

msgid "rule.messages.why"
msgstr "Historia i załączniki Wiadomości."

msgid "rule.system.why"
msgstr "Pliki systemu macOS. Usunięcie może uszkodzić system."

msgid "rule.vm_swap.why"
msgstr "Pamięć wymiany i obraz uśpienia, zarządzane przez macOS."

msgid "rule.var_db.why"
msgstr "Systemowe bazy danych (uprawnienia, konfiguracja)."

msgid "rule.var_folders.why"
msgstr "Dane tymczasowe użytkowników zarządzane przez macOS."

msgid "rule.usr.why"
msgstr "Podstawowe pliki systemu Unix."

msgid "rule.simulator_runtimes.why"
msgstr "Runtime'y symulatorów. Usuwane tylko poleceniem simctl."

msgid "rule.derived_data.why"
msgstr "Produkty buildów Xcode; odtworzą się przy następnym buildzie."

msgid "rule.xcode_archives.why"
msgstr "Archiwa aplikacji; potrzebne do symbolikacji crashy lub ponownej wysyłki buildu."

msgid "rule.ios_device_support.why"
msgstr "Symbole debugowe dla wersji iOS; pobiorą się ponownie po podłączeniu urządzenia."

msgid "rule.watchos_device_support.why"
msgstr "Symbole debugowe watchOS; pobiorą się ponownie po podłączeniu zegarka."

msgid "rule.simulator_caches.why"
msgstr "Cache symulatorów; odtworzą się automatycznie."

msgid "rule.simulator_devices.why"
msgstr "Urządzenie symulatora z zainstalowanymi aplikacjami i ich danymi."

msgid "rule.xcode_cache.why"
msgstr "Cache Xcode; odtworzy się automatycznie."

msgid "rule.xcode_previews.why"
msgstr "Buildy podglądów SwiftUI; odtworzą się w razie potrzeby."

msgid "rule.gradle_caches.why"
msgstr "Cache zależności Gradle; pobierze się ponownie przy następnym buildzie."

msgid "rule.gradle_wrapper.why"
msgstr "Pobrane dystrybucje Gradle; pobiorą się ponownie w razie potrzeby."

msgid "rule.android_avd.why"
msgstr "Emulator Androida z danymi i zainstalowanymi aplikacjami."

msgid "rule.android_system_images.why"
msgstr "Obraz systemu Android; odzyskanie wymaga dużego pobrania."

msgid "rule.docker_build_cache.why"
msgstr "Build cache Dockera; odtworzy się przy następnym buildzie."

msgid "rule.docker_dangling_images.why"
msgstr "Nieotagowane, osierocone warstwy obrazów."

msgid "rule.docker_unused_images.why"
msgstr "Obrazy nieużywane przez kontenery; trzeba będzie pobrać je ponownie."

msgid "rule.docker_stopped_containers.why"
msgstr "Zatrzymane kontenery; ich zapisane dane przepadną."

msgid "rule.docker_volumes.why"
msgstr "Wolumeny mogą przechowywać dane lokalnych baz."

msgid "rule.npm_cache.why"
msgstr "Cache pobrań npm; uzupełni się przez npm install."

msgid "rule.yarn_cache.why"
msgstr "Cache pobrań Yarn; uzupełni się przez yarn install."

msgid "rule.yarn_berry_cache.why"
msgstr "Globalny cache Yarn Berry; uzupełni się przez yarn install."

msgid "rule.pnpm_store.why"
msgstr "Magazyn paczek pnpm; uzupełni się przez pnpm install."

msgid "rule.homebrew_cache.why"
msgstr "Pobrane pliki Homebrew; niepotrzebne po instalacji."

msgid "rule.cocoapods_cache.why"
msgstr "Cache pobrań CocoaPods; uzupełni się przez pod install."

msgid "rule.cocoapods_repos.why"
msgstr "Repozytoria specyfikacji CocoaPods; sklonują się ponownie w razie potrzeby."

msgid "rule.user_logs.why"
msgstr "Logi aplikacji; tworzą się na nowo podczas działania."

msgid "rule.diagnostic_reports.why"
msgstr "Systemowe raporty awarii i diagnostyki."

msgid "rule.tm_snapshots.why"
msgstr "Lokalny snapshot Time Machine przechowywany na tym dysku."

msgid "rule.simctl_runtimes.why"
msgstr "Runtime symulatora; po usunięciu nie uruchomisz symulatorów tej wersji systemu."

msgid "rule.simctl_unavailable_devices.why"
msgstr "Symulatory bez runtime'u; nie da się ich już uruchomić."

msgid "rule.system_caches.why"
msgstr "Systemowy cache aplikacji; zwykle się odtwarza, niektóre aplikacje mogą stracić dane offline."

msgid "rule.user_caches.why"
msgstr "Cache aplikacji; zwykle się odtwarza, niektóre aplikacje mogą stracić dane offline."

msgid "rule.node_modules.why"
msgstr "Zależności projektu; odtworzą się przez yarn/npm install."

msgid "hint.tm_keep_newest"
msgstr "Zostaw najnowszy snapshot, usuń starsze."

msgid "hint.runtime_keep_current"
msgstr "Zostaw runtime używany przez Twój Xcode, usuń starsze."
